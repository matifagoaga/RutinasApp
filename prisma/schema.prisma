// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Student {
  id            String   @id @default(cuid())
  name          String
  email         String?
  phone         String?
  notes         String?
  token         String   @unique @default(cuid())
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  // Nota manual del entrenador ("marcar para seguimiento"). No nulo = está
  // marcado y aparece en "Necesitan atención" del panel de inicio.
  attentionNote String?
  // Si pertenece a un equipo, es un "jugador": misma ficha que un alumno,
  // pero con Testeos en vez de Pagos (eso lo maneja el club).
  teamId        String?
  team          Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)

  routines    Routine[]
  workoutLogs WorkoutLog[]
  bodyMetrics BodyMetric[]
  payments    Payment[]
  testeos     Testeo[]

  @@index([teamId])
}

model Team {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  players Student[]
}

// Prueba física libre (nombre + valor a elección del entrenador, ej.
// "Sprint 40m" -> "5.2 seg"), para trackear el progreso de un jugador.
// Se cargan de a tandas (una "sesión" de testeos con varios ejercicios el
// mismo día, ej. "Inicio de año"): sessionLabel agrupa esas filas sin ser
// una relación propia, misma idea que ExerciseTemplate con las rutinas.
model Testeo {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name         String
  value        String
  // Fecha "lógica" del testeo, editable por el entrenador (puede cargarse
  // con fecha pasada). createdAt es el momento real de carga y sólo se usa
  // como desempate al ordenar filas con la misma date.
  date         DateTime @default(now()) @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  notes        String?
  sessionLabel String?

  @@index([studentId])
}

model Routine {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  days RoutineDay[]

  @@index([studentId])
}

model RoutineDay {
  id        String  @id @default(cuid())
  routineId String
  routine   Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  label     String
  order     Int     @default(0)

  blocks      ExerciseBlock[]
  workoutLogs WorkoutLog[]

  @@index([routineId])
}

model ExerciseBlock {
  id    String     @id @default(cuid())
  dayId String
  day   RoutineDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  // Nombre opcional (ej. "Bloque A"). Vacío = un solo ejercicio/bloque simple,
  // sin necesidad de mostrar el concepto de "bloque" al entrenador.
  label String     @default("")
  order Int        @default(0)

  exercises Exercise[]

  @@index([dayId])
}

model Exercise {
  id          String        @id @default(cuid())
  blockId     String
  block       ExerciseBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  order       Int           @default(0)
  name        String
  sets        Int
  reps        String
  weight      String?
  restSeconds Int?
  notes       String?
  videoUrl    String?
  imageData   String?

  @@index([blockId])
}

model WorkoutLog {
  id           String      @id @default(cuid())
  studentId    String
  student      Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  routineDayId String?
  routineDay   RoutineDay? @relation(fields: [routineDayId], references: [id], onDelete: SetNull)
  date         DateTime    @default(now()) @db.Timestamptz(3)
  feeling      String?

  entries WorkoutLogEntry[]

  @@index([studentId])
}

model WorkoutLogEntry {
  id            String     @id @default(cuid())
  workoutLogId  String
  workoutLog    WorkoutLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
  exerciseName  String
  setsCompleted Int?
  repsActual    String?
  weightActual  String?

  @@index([workoutLogId])
}

model BodyMetric {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime @default(now()) @db.Timestamptz(3)
  weightKg  Float?
  notes     String?

  @@index([studentId])
}

model Payment {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // Período que cubre el pago, formato "YYYY-MM" (ej. "2026-09").
  month     String
  amount    Float?
  notes     String?
  paidAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([studentId])
}

// Ejercicios reutilizables: el entrenador los carga una vez y los inserta
// en cualquier rutina sin volver a tipear/subir todo de cero. Insertar una
// copia en una rutina no crea ninguna relación con este modelo — cada
// Exercise queda independiente, igual que hoy.
model ExerciseTemplate {
  id          String   @id @default(cuid())
  name        String
  // Grupo muscular / tipo, para organizar la biblioteca (ej. "Pecho", "Piernas").
  category    String?
  sets        Int      @default(3)
  reps        String   @default("10-12")
  weight      String?
  restSeconds Int?
  notes       String?
  videoUrl    String?
  imageData   String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
}

// Rutina completa (días/bloques/ejercicios) reutilizable, sin dueño. El
// entrenador la guarda una vez desde el editor de un alumno y después la
// aplica a cualquier otro alumno/jugador para no armar todo de cero.
// Aplicarla no crea ninguna relación con este modelo — copia los datos,
// igual que ExerciseTemplate.
model RoutineTemplate {
  id        String   @id @default(cuid())
  title     String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  days RoutineTemplateDay[]
}

model RoutineTemplateDay {
  id                String          @id @default(cuid())
  routineTemplateId String
  routineTemplate   RoutineTemplate @relation(fields: [routineTemplateId], references: [id], onDelete: Cascade)
  label             String
  order             Int             @default(0)

  blocks RoutineTemplateBlock[]

  @@index([routineTemplateId])
}

model RoutineTemplateBlock {
  id    String             @id @default(cuid())
  dayId String
  day   RoutineTemplateDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  label String             @default("")
  order Int                @default(0)

  exercises RoutineTemplateExercise[]

  @@index([dayId])
}

model RoutineTemplateExercise {
  id          String               @id @default(cuid())
  blockId     String
  block       RoutineTemplateBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  order       Int                  @default(0)
  name        String
  sets        Int
  reps        String
  weight      String?
  restSeconds Int?
  notes       String?
  videoUrl    String?
  imageData   String?

  @@index([blockId])
}
