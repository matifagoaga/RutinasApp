# Base de datos. En desarrollo local queda como SQLite; en producción (Vercel)
# se reemplaza por la connection string de Neon (postgresql://...).
DATABASE_URL="file:./dev.db"

# Clave secreta para firmar la cookie de sesión del entrenador. Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="cambiame-por-un-valor-random-largo"
